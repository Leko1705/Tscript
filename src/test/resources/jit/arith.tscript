module arith;

function f(a, b) {
    return [a + b, a - b, a * b, a / b, a ^ 2, -a, +a, a < b, a > b, a <= b, a >= b, a == b, a != b];
}

function g(a, b) {
    return [a // b, a % b, a and b, a or b, a xor b, not a, a << 2, a >> 1];
}

function h(a, b) {
    return [a and b, a or b, a xor b, not a, a == b, a != b];
}

var res = null;
for var i in 1:400 do {
    res = f(i, 3);
    res = f(i * 0.5, 3);
    res = f(3, i * 0.25);
    res = g(i, 3);
    res = g(-i, 5);
    res = h(i % 2 == 0, i % 3 == 0);
}
print(f(7, 3));
print(f(7.5, 3));
print(f(3, 7.5));
print(g(17, 5));
print(g(-17, 5));
print(h(true, false));
print(h(false, false));

var acc = 0;
for var i in 0:2000 do {
    acc = acc + (i * 31) % 17 - (i // 3) + (i and 5) + (i << 1) - (i >> 2);
}
print(acc);

var fl = 0.0;
for var i in 1:2000 do {
    fl = fl + 1 / i - i ^ 0.5 / 1000;
}
print(fl);

var cmp = 0;
for var i in 0:2000 do {
    if i < 1000 and i >= 10 then cmp = cmp + 1;
    if not (i > 1500) then cmp = cmp + 2;
    if i == 77 or i != 78 then cmp = cmp + 3;
}
print(cmp);
